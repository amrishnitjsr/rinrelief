{
  "name": "loan-wala",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:client": "npm --prefix apps/client run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "build": "next build",
    "build:client": "npm --prefix apps/client run build",
    "build:admin": "npm --prefix apps/admin run build",
    "build:api": "npm --prefix apps/api run build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed:admin": "prisma db seed"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.468.0",
    "next": "^15.0.4",
    "next-auth": "^5.0.0-beta.32",
    "razorpay": "^2.9.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "resend": "^6.34.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
